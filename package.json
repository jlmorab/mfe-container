{
  "name": "@jlmorab/root-config",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "dotenv -e .env.local -- cross-var webpack serve --port %HOST_PORT% --env isLocal",
    "lint": "eslint src --ext js,ts,tsx",
    "test": "cross-env BABEL_ENV=test jest --passWithNoTests",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "prepare": "husky install",
    "build": "concurrently npm:build:*",
    "build:webpack": "dotenv -e .env-prod -- webpack --mode=production",
    "build:types": "tsc"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/runtime": "^7.28.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^6.5.1",
    "cross-env": "^7.0.3",
    "cross-var": "^1.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-ts-important-stuff": "^1.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "html-webpack-plugin": "^5.6.5",
    "husky": "^7.0.4",
    "jest": "^27.5.1",
    "jest-cli": "^27.5.1",
    "prettier": "^3.7.4",
    "pretty-quick": "^4.2.2",
    "serve": "^13.0.4",
    "ts-config-single-spa": "^3.0.0",
    "typescript": "^4.9.5",
    "webpack": "^5.104.1",
    "webpack-cli": "^4.10.0",
    "webpack-config-single-spa-ts": "^8.0.0",
    "webpack-dev-server": "^4.15.2",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "@types/jest": "^27.5.2",
    "@types/systemjs": "^6.15.4",
    "@types/webpack-env": "^1.18.8",
    "single-spa": "^5.9.5",
    "single-spa-layout": "^1.6.1"
  },
  "types": "dist/jlmorab-root-config.d.ts",
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
